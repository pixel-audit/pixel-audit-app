# Rendered into /etc/nginx/conf.d/default.conf by the nginx image's entrypoint
# with envsubst — only the PORT variable is substituted (NGINX_ENVSUBST_FILTER in the
# Dockerfile), so nginx's own $uri stays as written.

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # "Server: nginx" without the version, on responses and error pages alike.
    # Dropping the header entirely needs the headers-more module, which the
    # stock image does not ship.
    server_tokens off;

    gzip on;
    gzip_vary on;
    gzip_types text/plain text/css application/json application/javascript image/svg+xml;

    # An admin panel has no business in search engines: public/robots.txt
    # disallows everything for crawlers that read it, and every response
    # carries the equivalent header for those that index whatever they fetch.
    # nginx does not inherit add_header into a location that has its own, so
    # the header is repeated in each location below.
    location /assets/ {
        # Vite writes hashed filenames under /assets, so they can be cached forever.
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri =404;
    }

    # Client-side routing (TanStack Router): every unknown path serves the app
    # shell. index.html itself is revalidated on each load so a new deploy is
    # picked up right away.
    location / {
        add_header Cache-Control "no-cache";
        add_header X-Robots-Tag "noindex, nofollow" always;
        try_files $uri $uri/ /index.html;
    }
}
