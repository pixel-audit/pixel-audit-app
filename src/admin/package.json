{
  "name": "pixelaudit-admin",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "api:generate": "orval",
    "check": "npm run i18n:check && npm run typecheck && npm run lint && npm run test",
    "i18n:extract": "node scripts/i18n.mjs extract",
    "i18n:check": "node scripts/i18n.mjs check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
