# Connections defined by the environment, read by the `boot` role
# (`make boot`, or the boot Job of the Helm chart) and mapped onto
# connection rows. foreman (`make up`) loads this file as .env.
#
#   CONNECTION_<id>_TYPE = meta | bigquery | postgres | clickhouse
#   CONNECTION_<id>_<PARAM> = ...        one per credential of the type
#
# <id> is the connection's code: lowercase letters and digits, case-sensitive.
# GET /api/admin/v1/connections/types lists every type's parameters.

# A Meta pixel through the Graph API.
CONNECTION_fb_TYPE=meta
CONNECTION_fb_ACCESS_TOKEN=EAA...
CONNECTION_fb_PIXEL_ID=123456789012345
# CONNECTION_fb_API_VERSION=v25.0

# A BigQuery project (GA4 export, Google Ads transfer). The key file as
# JSON, or base64 of it: base64 < service-account.json | tr -d '\n'
CONNECTION_bq_TYPE=bigquery
CONNECTION_bq_PROJECT_ID=my-project
CONNECTION_bq_CREDENTIALS_JSON=ewogICJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLgp9
# CONNECTION_bq_LOCATION=EU

# The sample Postgres of docker-compose.yml (`make targets-up`).
CONNECTION_shop_TYPE=postgres
CONNECTION_shop_URL=postgres://sample:sample@localhost:15461/shop

# The sample ClickHouse of docker-compose.yml (`make targets-up`).
CONNECTION_events_TYPE=clickhouse
CONNECTION_events_URL=http://sample:sample@localhost:18123/shop
